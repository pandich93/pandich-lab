// @name Канал Дончиана
// @category Волатильность
// @desc Максимум/минимум за N баров и середина; пробой — сигнал.
// @tags donchian
//@version=6
indicator("Канал Дончиана", overlay = true)
len = input.int(20, "Период", minval = 1)
up = ta.highest(len)
dn = ta.lowest(len)
plot(up, "Верх", color = #26a69a)
plot(dn, "Низ", color = #ef5350)
plot(math.avg(up, dn), "Середина", color = color.new(#9e9e9e, 30))
alertcondition(close > up[1], "Пробой вверх", "Закрытие выше канала Дончиана")
alertcondition(close < dn[1], "Пробой вниз", "Закрытие ниже канала Дончиана")
