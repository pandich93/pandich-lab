// @name CCI
// @category Осцилляторы
// @desc Commodity Channel Index ±100.
// @tags сиси cci
//@version=6
indicator("CCI", overlay = false)
len = input.int(20, "Период", minval = 1)
c = ta.cci(hlc3, len)
plot(c, "CCI", color = #00bcd4)
hline(100, "+100", color = color.new(#ef5350, 40))
hline(0, "0", color = color.new(#9e9e9e, 60))
hline(-100, "−100", color = color.new(#26a69a, 40))
