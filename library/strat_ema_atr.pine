// @name Стратегия: пересечение EMA + ATR-стоп
// @category Стратегии
// @desc Пример для тестера: вход по пересечению EMA, стоп и тейк в ATR.
// @tags strategy backtest бэктест
//@version=6
strategy("EMA cross + ATR", overlay = true, initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 10)
fastLen = input.int(20, "Быстрая EMA", minval = 1)
slowLen = input.int(50, "Медленная EMA", minval = 1)
atrLen = input.int(14, "ATR", minval = 1)
slK = input.float(1.5, "Стоп, ATR", step = 0.1)
tpK = input.float(3.0, "Тейк, ATR", step = 0.1)
f = ta.ema(close, fastLen)
s = ta.ema(close, slowLen)
a = ta.atr(atrLen)
plot(f, "Быстрая", color = #f7a600)
plot(s, "Медленная", color = #2962ff)
if ta.crossover(f, s)
    strategy.entry("Long", strategy.long)
    strategy.exit("Long X", "Long", stop = close - slK * a, limit = close + tpK * a)
if ta.crossunder(f, s)
    strategy.entry("Short", strategy.short)
    strategy.exit("Short X", "Short", stop = close + slK * a, limit = close - tpK * a)
