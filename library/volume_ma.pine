// @name Объём + средняя
// @category Объём
// @desc Гистограмма объёма, средняя и всплески выше средней × k.
// @tags volume
//@version=6
indicator("Объём + средняя", overlay = false)
len = input.int(20, "Средняя", minval = 1)
k = input.float(2.0, "Всплеск, ×", step = 0.1)
v = nz(volume)
avgV = ta.sma(v, len)
spike = v > avgV * k
plot(v, "Объём", style = plot.style_columns, color = spike ? #ff9800 : close >= open ? color.new(#26a69a, 40) : color.new(#ef5350, 40))
plot(avgV, "Средняя", color = #2962ff)
alertcondition(spike, "Всплеск объёма", "Объём выше средней в k раз")
